********************************************************************************
* 13. PREMATURE AMI LOGISTIC REGRESSION MODELS
********************************************************************************

tempfile premature
tempname ppost
postfile `ppost' str30 threshold str45 disease_name str30 disease_var str20 model double or lci uci p using `premature', replace

foreach thr in 40 50 55 65 {
    foreach d of local disease_vars {
        local dname : variable label `d'
        if "`dname'" == "" local dname "`d'"

        quietly count if `d' == 1 & age_lt`thr' == 1
        local cell1 = r(N)
        quietly count if `d' == 1 & age_lt`thr' == 0
        local cell0 = r(N)
        if `cell1' == 0 | `cell0' == 0 di as error "Potential separation/sparse cells: `dname', age <`thr'."

        svy: logistic age_lt`thr' i.`d' i.female i.race_cat
        estimates store logit_demo_`d'_lt`thr'
        matrix T = r(table)
        local col = colnumb(T, "1.`d'")
        if !missing(`col') post `ppost' ("Age <`thr'") ("`dname'") ("`d'") ("Sex/race") (T[1,`col']) (T[5,`col']) (T[6,`col']) (T[4,`col'])

        svy: logistic age_lt`thr' i.`d' i.female i.race_cat i.${YEARVAR} longterm_steroid longterm_immunosuppressant
        estimates store logit_primary_`d'_lt`thr'
        matrix T = r(table)
        local col = colnumb(T, "1.`d'")
        if !missing(`col') post `ppost' ("Age <`thr'") ("`dname'") ("`d'") ("Primary") (T[1,`col']) (T[5,`col']) (T[6,`col']) (T[4,`col'])
    }
}
postclose `ppost'

use `premature', clear
export delimited using "$OUTDIR/premature_ami_logistic_results.csv", replace
use `analytic', clear

