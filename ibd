local disease_vars sle ra crohn uc ibd psoriasis psoriatic_arthritis ank_spond systemic_sclerosis sjogren inflam_myopathy vasculitis ms other_autoimmune
local disease_labels "Systemic lupus erythematosus" "Rheumatoid arthritis" "Crohn disease" "Ulcerative colitis" "Inflammatory bowel disease" "Psoriasis" "Psoriatic arthritis" "Ankylosing/axial spondyloarthritis" "Systemic sclerosis" "Sjogren syndrome" "Inflammatory myopathy" "Systemic vasculitis" "Multiple sclerosis" "Other autoimmune disease"
local disease_model_vars sle ra crohn uc psoriasis psoriatic_arthritis ank_spond systemic_sclerosis sjogren inflam_myopathy vasculitis ms other_autoimmune
local disease_model_ibd_vars sle ra ibd psoriasis psoriatic_arthritis ank_spond systemic_sclerosis sjogren inflam_myopathy vasculitis ms other_autoimmune

check_binary `disease_vars' longterm_steroid longterm_immunosuppressant any_immunosuppressive_use

egen autoimmune_count = rowtotal(`disease_model_vars')
