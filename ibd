********************************************************************************
* 10. PRIMARY DISEASE-SPECIFIC LINEAR REGRESSION AND MARGINS
********************************************************************************

tempname rpost
postfile `rpost' str45 disease_name str30 disease_var double unweighted_n weighted_n crude_mean_age adj_mean_present adj_present_lci adj_present_uci adj_mean_absent adj_absent_lci adj_absent_uci beta lci uci raw_p q_value using `results', replace

local i = 0
foreach d of local disease_vars {
    local ++i
    local dname : variable label `d'
    if "`dname'" == "" local dname "`d'"

    quietly count if `d' == 1
    local dn = r(N)
    get_weighted_total if `d' == 1
    local dwn = r(weighted_n)
    quietly mean ${AGEVAR} [pweight = ${WT_VAR}] if `d' == 1
    local crude = _b[${AGEVAR}]

    * Model 1: demographic adjusted.
    svy: regress ${AGEVAR} i.`d' i.female i.race_cat
    estimates store m1_`d'

    * Model 2: primary minimally adjusted; age is the outcome and is not adjusted for.
    svy: regress ${AGEVAR} i.`d' i.female i.race_cat i.${YEARVAR} longterm_steroid longterm_immunosuppressant
    estimates store m2_`d'

    matrix T = r(table)
    local col = colnumb(T, "1.`d'")
    if missing(`col') {
        local b = .
        local ll = .
        local uu = .
        local p = .
    }
    else {
        local b = T[1, `col']
        local ll = T[5, `col']
        local uu = T[6, `col']
        local p = T[4, `col']
    }

    margins `d'
    matrix MT = r(table)
    local mean0 = MT[1,1]
    local lci0 = MT[5,1]
    local uci0 = MT[6,1]
    local mean1 = MT[1,2]
    local lci1 = MT[5,2]
    local uci1 = MT[6,2]
    margins, dydx(`d')

    post `rpost' ("`dname'") ("`d'") (`dn') (`dwn') (`crude') (`mean1') (`lci1') (`uci1') (`mean0') (`lci0') (`uci0') (`b') (`ll') (`uu') (`p') (.)

    * Sparse-cell flag for interpretation.
    if `dn' < `sparse_n' di as error "Sparse disease group: `dname' has unweighted N=`dn'. Interpret estimates cautiously."
}
postclose `rpost'

* Benjamini-Hochberg FDR q-values for primary disease-specific estimates.
use `results', clear
generate long sort_original = _n
sort raw_p
generate rank_p = _n if raw_p < .
quietly count if raw_p < .
local m = r(N)
generate bh_value = raw_p * `m' / rank_p if raw_p < .
generate q_tmp = .
forvalues j = `m'(-1)1 {
    if `j' == `m' replace q_tmp = min(bh_value, 1) in `j'
    else replace q_tmp = min(bh_value, q_tmp[_n+1], 1) in `j'
}
replace q_value = q_tmp
sort sort_original
drop sort_original rank_p bh_value q_tmp
save `results', replace
export delimited using "$OUTDIR/primary_linear_regression_results.csv", replace
export excel using "$OUTDIR/primary_linear_regression_results.xlsx", firstrow(variables) replace
use `analytic', clear

