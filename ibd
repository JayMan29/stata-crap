********************************************************************************
* 6. AMI, OLD MI, AND EXCLUSION INDICATORS
********************************************************************************

* Clean principal diagnosis and create AMI subtype indicators.
generate str12 dx1_clean = upper(subinstr(${DX_PREFIX}1, ".", "", .))
label variable dx1_clean "Principal diagnosis without periods, uppercase"

generate byte ami_stemi = 0
generate byte ami_nstemi = 0
generate byte ami_other_unspecified = 0
foreach p of local ami_stemi_prefix {
    replace ami_stemi = 1 if substr(dx1_clean, 1, length("`p'")) == "`p'"
}
foreach p of local ami_nstemi_prefix {
    replace ami_nstemi = 1 if substr(dx1_clean, 1, length("`p'")) == "`p'"
}
foreach p of local ami_other_prefix {
    replace ami_other_unspecified = 1 if substr(dx1_clean, 1, length("`p'")) == "`p'"
}

generate byte principal_ami = ami_stemi == 1 | ami_nstemi == 1 | ami_other_unspecified == 1
label variable ami_stemi "Principal-diagnosis STEMI"
label variable ami_nstemi "Principal-diagnosis NSTEMI"
label variable ami_other_unspecified "Principal-diagnosis other/unspecified AMI"
label variable principal_ami "Principal-diagnosis acute MI"

* Create old/prior MI indicator before exclusions, using all diagnosis fields.
generate byte old_mi_i252 = 0
foreach dx of varlist `dxvars' {
    replace old_mi_i252 = 1 if upper(subinstr(`dx', ".", "", .)) == "`old_mi_exact'"
}
label variable old_mi_i252 "Any diagnosis I25.2 old/prior MI"

check_binary ami_stemi ami_nstemi ami_other_unspecified principal_ami old_mi_i252

* Report exclusions and then apply them. Counts are sequential.
count if missing(${AGEVAR})
local excl_unw = r(N)
get_weighted_total if missing(${AGEVAR})
local excl_w = r(weighted_n)
di as text "Excluded for missing age: unweighted=`excl_unw' weighted=`excl_w'"
drop if missing(${AGEVAR})
post_flow, step("After excluding missing age") handle(`fpost')

count if ${AGEVAR} < 18
local excl_unw = r(N)
get_weighted_total if ${AGEVAR} < 18
local excl_w = r(weighted_n)
di as text "Excluded for age <18: unweighted=`excl_unw' weighted=`excl_w'"
drop if ${AGEVAR} < 18
post_flow, step("After restricting to adults age >=18") handle(`fpost')

count if missing(${SEXVAR})
local excl_unw = r(N)
get_weighted_total if missing(${SEXVAR})
local excl_w = r(weighted_n)
di as text "Excluded for missing sex: unweighted=`excl_unw' weighted=`excl_w'"
drop if missing(${SEXVAR})
post_flow, step("After excluding missing sex") handle(`fpost')

count if principal_ami != 1
local excl_unw = r(N)
get_weighted_total if principal_ami != 1
local excl_w = r(weighted_n)
di as text "Excluded for not meeting principal-diagnosis AMI definition: unweighted=`excl_unw' weighted=`excl_w'"
drop if principal_ami != 1
post_flow, step("After keeping adult principal-diagnosis AMI") handle(`fpost')

count if old_mi_i252 == 1
local excl_unw = r(N)
get_weighted_total if old_mi_i252 == 1
local excl_w = r(weighted_n)
di as text "Excluded for I25.2 old/prior MI in any diagnosis field: unweighted=`excl_unw' weighted=`excl_w'"
drop if old_mi_i252 == 1
post_flow, step("After excluding any I25.2 old/prior MI code") handle(`fpost')

count if missing(${RACEVAR})
local excl_unw = r(N)
get_weighted_total if missing(${RACEVAR})
local excl_w = r(weighted_n)
di as text "Excluded for missing race in primary complete-case cohort: unweighted=`excl_unw' weighted=`excl_w'"
drop if missing(${RACEVAR})
post_flow, step("Final primary complete-case AMI cohort") handle(`fpost')
postclose `fpost'

* Final cohort verification: no I25.2 remains and all records are eligible adult AMI.
assert ${AGEVAR} >= 18 & ${AGEVAR} < .
assert principal_ami == 1
assert !missing(${SEXVAR})
assert !missing(${RACEVAR})
assert old_mi_i252 == 0
foreach dx of varlist `dxvars' {
    assert upper(subinstr(`dx', ".", "", .)) != "`old_mi_exact'"
}

