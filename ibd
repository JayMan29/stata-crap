********************************************************************************
* 9. DESCRIPTIVE TABLES
********************************************************************************

* Disease-specific columns are non-mutually exclusive and should not be summed.
tempname dpost
postfile `dpost' str45 group_name str30 group_var double unweighted_n weighted_n mean_age mean_lci mean_uci sd_age median_age p25_age p75_age pct_female pct_steroid pct_immunosupp pct_any_immunosupp pct_stemi pct_nstemi pct_lt40 pct_lt50 pct_lt55 pct_lt65 using `desc', replace

local table_groups no_autoimmune any_autoimmune `disease_vars'
foreach g of local table_groups {
    local glabel : variable label `g'
    if "`glabel'" == "" local glabel "`g'"

    quietly count if `g' == 1
    local unw = r(N)
    get_weighted_total if `g' == 1
    local ww = r(weighted_n)

    quietly svy, subpop(`g'): mean ${AGEVAR}
    matrix M = r(table)
    local mage = M[1,1]
    local mlci = M[5,1]
    local muci = M[6,1]
    estat sd
    matrix S = r(sd)
    local sdage = S[1,1]

    quietly summarize ${AGEVAR} [aweight = ${WT_VAR}] if `g' == 1, detail
    local med = r(p50)
    local p25 = r(p25)
    local p75 = r(p75)

    foreach x in female longterm_steroid longterm_immunosuppressant any_immunosuppressive_use ami_stemi ami_nstemi age_lt40 age_lt50 age_lt55 age_lt65 {
        quietly mean `x' [pweight = ${WT_VAR}] if `g' == 1
        local p_`x' = _b[`x'] * 100
    }

    post `dpost' ("`glabel'") ("`g'") (`unw') (`ww') (`mage') (`mlci') (`muci') (`sdage') (`med') (`p25') (`p75') (`p_female') (`p_longterm_steroid') (`p_longterm_immunosuppressant') (`p_any_immunosuppressive_use') (`p_ami_stemi') (`p_ami_nstemi') (`p_age_lt40') (`p_age_lt50') (`p_age_lt55') (`p_age_lt65')

    svy, subpop(`g'): proportion female race_cat longterm_steroid longterm_immunosuppressant any_immunosuppressive_use ami_stemi ami_nstemi age_lt40 age_lt50 age_lt55 age_lt65
}
