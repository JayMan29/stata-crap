global YEARVAR     "YEAR"         // NIS calendar year

global WT_VAR      "DISCWT"       // discharge weight
global STRATA_VAR  "NIS_STRATUM"  // NIS stratum
global PSU_VAR     "HOSP_NIS"     // hospital cluster identifier
global DX_PREFIX   "I10_DX"       // diagnosis variables are I10_DX1, I10_DX2, ...

* Number of diagnosis fields. If blank, the script auto-detects all variables beginning
* with $DX_PREFIX. Set manually only if needed, for example: global MAX_DX "40".
global MAX_DX ""

* Minimum unweighted N used to flag sparse disease groups.
local sparse_n 30

********************************************************************************
* 1. ICD-10-CM CODE MACROS FOR REVIEW AND EDITING
********************************************************************************

* AMI principal-diagnosis code families. Codes are compared after removing periods.
local ami_stemi_prefix      "I210 I211 I212 I213 I220 I221 I228 I229"
local ami_nstemi_prefix     "I214 I222"
local ami_other_prefix      "I219 I21A I21B"
local old_mi_exact          "I252"

* Autoimmune/chronic inflammatory disease code families for secondary diagnoses.
* These are editable, prespecified code-family macros; validate against your protocol.
local sle_prefix            "M32"
local ra_prefix             "M05 M06"
local crohn_prefix          "K50"
local uc_prefix             "K51"
local psoriasis_prefix      "L40"
local psoriatic_arth_prefix "L405 M070 M071 M072 M073"
local ank_spond_prefix      "M45 M468 M469"
local systemic_sclerosis_prefix "M34"
local sjogren_prefix        "M350"
local inflam_myopathy_prefix "M330 M331 M332 M339"
local vasculitis_prefix     "M30 M31"
local ms_prefix             "G35"
local other_autoimmune_prefix ""   // optional placeholder; leave blank unless prespecified

* Medication-use code families. Matched to documented long-term-use Z79.5/Z79.6 families.
local steroid_prefix        "Z795"
local immunosupp_prefix     "Z796"

********************************************************************************
* 2. BASIC VARIABLE AND DIAGNOSIS-FIELD CHECKS
********************************************************************************

foreach v in $AGEVAR $SEXVAR $RACEVAR $YEARVAR $WT_VAR $STRATA_VAR $PSU_VAR {
    capture confirm variable `v'
    if _rc {
        di as error "Required variable `v' was not found. Update USER SETTINGS."
        exit 111
    }
}

if "$MAX_DX" == "" {
    ds ${DX_PREFIX}*
    local dxvars `r(varlist)'
}
else {
    local dxvars
    forvalues j = 1/$MAX_DX {
        capture confirm variable ${DX_PREFIX}`j'
        if !_rc local dxvars `dxvars' ${DX_PREFIX}`j'
    }
}

if "`dxvars'" == "" {
    di as error "No diagnosis variables found. Update DX_PREFIX or MAX_DX."
    exit 111
}

capture confirm variable ${DX_PREFIX}1
if _rc {
    di as error "Principal diagnosis variable ${DX_PREFIX}1 not found."
    exit 111
}

local dx_secondary : list dxvars - ${DX_PREFIX}1
if "`dx_secondary'" == "" {
    di as error "No secondary diagnosis fields detected. Autoimmune exposure coding requires secondary diagnoses."
    exit 111
}

preserve
tempfile original analytic flow codebook desc results forest agecat
save `original', replace

********************************************************************************
* 3. HELPER PROGRAMS
********************************************************************************

capture program drop make_prefix_indicator
program define make_prefix_indicator
    version 17.0
    syntax, Generate(name) DXVars(string) Prefixes(string) [Label(string)]
    tempvar clean
    generate byte `generate' = 0
    foreach dx of varlist `dxvars' {
        quietly replace `generate' = 1 if `generate' == 0 & `dx' != "" & inlist(1, 0)
        foreach p of local prefixes {
            quietly replace `generate' = 1 if `generate' == 0 & ///
                substr(upper(subinstr(`dx', ".", "", .)), 1, length("`p'")) == "`p'"
        }
    }
    if "`label'" != "" label variable `generate' "`label'"
end

capture program drop check_binary
program define check_binary
    version 17.0
    syntax varlist
    foreach v of varlist `varlist' {
        capture assert inlist(`v', 0, 1) if !missing(`v')
        if _rc {
            di as error "Binary check failed for `v'."
            exit 459
        }
    }
end

capture program drop post_flow
program define post_flow
    version 17.0
    syntax, Step(string) Handle(name)
    quietly count
    local n = r(N)
    quietly total one [pweight = ${WT_VAR}]
    matrix b = e(b)
    local w = b[1,1]
    post `handle' ("`step'") (`n') (`w')
end

capture program drop get_weighted_total
program define get_weighted_total, rclass
    version 17.0
    syntax [if/]
    quietly total one [pweight = ${WT_VAR}] `if'
    matrix b = e(b)
    return scalar weighted_n = b[1,1]
end

