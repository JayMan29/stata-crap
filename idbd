************************************************************

keep if AGE >= 18


************************************************************
*IDENTIFY MI Codes (primary only)
************************************************************
**MI Codes**
*STEMI: I21.0–I21.3, I22.0, I22.1, I22.8, I22.9
*NSTEMI: I21.4, I22.2
gen Disease = 0
replace Disease = 1 if ///
    substr(I10_DX1,1,4)=="I210" | ///
    substr(I10_DX1,1,4)=="I211" | ///
    substr(I10_DX1,1,4)=="I212" | ///
    substr(I10_DX1,1,4)=="I213" | ///
    substr(I10_DX1,1,4)=="I214" 

keep if Disease==1

*adult Generic Disease DX1 to DX40
generate adultDisease=0
replace adultDisease=1 if Disease==1 & AGE>=18
svy, subpop (adult): total adultDisease, cformat(%9.0fc)
svy, subpop (adult): proportion adultDisease

*COMORBIDITY= NSTEMI
*NSTEMI: I21.4, I22.2
gen comborbiditydx1to40 = 0
replace comborbiditydx1to40 = 1 if ///
    substr(I10_DX1,1,4)=="I214" 

svy: total comborbiditydx1to40, cformat(%9.0fc)
svy: proportion comborbiditydx1to40

*Adult Generic Comorbidity
generate adultcomborbiditydx1to40=0
replace adultcomborbiditydx1to40=1 if comborbiditydx1to40==1 
svy: total adultcomborbiditydx1to40, cformat(%9.0fc)

*TWO GROUPS: Generic Adult Disease with and without a specific comoribidty

*Generic disease as DX1-40 diagnoses plus specific comborbidity
generate adultDiseasewComorbidity=0
replace adultDiseasewComorbidity=1 if adultDisease==1 & adultcomborbiditydx1to40==1
svy: total adultDiseasewComorbidity
svy, subpop (adultDisease): total adultcomborbiditydx1to40, cformat(%9.0fc)
svy, subpop (adultDisease): proportion adultcomborbiditydx1to40

*Generic Disease as DX1-40 diagnoses without specific comorbidity
**Without Comorbidity=STEMI
generate adultDiseasewoComorbidity=0
replace adultDiseasewoComorbidity=1 if adultDisease==1 & adultcomborbiditydx1to40 !=1
svy: total adultDiseasewoComorbidity
svy, subpop (adultDisease): total adultDiseasewoComorbidity, cformat(%9.0fc)
svy, subpop (adultDisease): proportion adultDiseasewoComorbidity

