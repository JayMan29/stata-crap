replace agegrp = 2 if AGE>=30 & AGE<=39
replace agegrp = 3 if AGE>=40 & AGE<=49
replace agegrp = 4 if AGE>=50 & AGE<=59
replace agegrp = 5 if AGE>=60 & AGE<=69
replace agegrp = 6 if AGE>=70

